rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı profilleri: herkese açık okuma KAPALI.
    // Her kullanıcı yalnızca kendi dokümanını okuyup yazabilir.
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // İş İlanları: herkes okuyabilir. YENİ ilan oluşturma yalnızca backend'de
    // yapılır (Admin SDK kuralları bypass eder; ödeme doğrulaması sunucuda).
    // TAM TARAMA (22.11): update istemciye tamamen KAPALI — önceden sahibin
    // kendisine açıktı; bu, bitisTarihi'ni ücretsiz uzatma / isFeatured'i
    // bedava vitrine çevirme (ödeme bypass) yolunu açık bırakıyordu.
    // İstemcide ilan güncelleme akışı yok; düzenleme gerektiğinde backend
    // endpoint'i eklenir. Silme (KVKK) sunucuda Admin SDK ile yapılır —
    // kurallara takılmaz; istemciden silme de kapatıldı.
    match /is_ilanlari/{jobId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // İndirim İlanları (Fırsatlar): aynı model — create/update/delete
    // yalnızca backend (Admin SDK).
    match /indirim_ilanlari/{dealId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Taksiler: aynı model — create/update/delete yalnızca backend.
    match /taksiler/{taxiId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Kullanıcı Favorileri (Sadece giriş yapmış kullanıcı kendi favorilerini okuyup yazabilir)
    match /userFavorites/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /jobListings/{jobId} {
      allow read, write: if true;
    }
    match /deals/{dealId} {
      allow read, write: if true;
    }
    match /userFavorites/{userId} {
      allow read, write: if true;
    }
  }
}

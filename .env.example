# ============================================================================
# Van Rehberim — ortam değişkenleri şablonu (aşama 3: eksiksiz liste)
# ----------------------------------------------------------------------------
# İKİ ayrı ortam vardır; karıştırmayın:
#  - İSTEMCİ (VITE_ ön ekli)   → Vite, bunları build sırasında istemci
#    bundle'ına GÖMER. Render.com'a girilmezler; yerelde .env dosyasında
#    tutulur, Android APK build'inde kullanılır.
#  - SUNUCU (VITE_ öneksiz)    → Yalnızca backend (Render.com Environment
#    Variables paneline girilir). Build bundle'ına asla girmez.
# ============================================================================

# ----------------------------------------------------------------------------
# 1) İSTEMCİ (VITE_) — yerel .env; APK/web build'ine gömülür
# ----------------------------------------------------------------------------

# Backend API base URL — istemci servisleri (busService, ödeme akışı vb.)
# bu adresin /api/... yollarını çağırır.
VITE_API_URL="https://van-rehberim-api.onrender.com"

# RevenueCat PUBLIC Google Play API anahtarı (RevenueCat Dashboard →
# Project settings → API keys → "Google Play" public key, goog_ ile başlar).
# Bu anahtar istemciye gömülmek ÜZERE tasarlanmıştır (secret değildir).
VITE_REVENUECAT_API_KEY="goog_YOUR_REVENUECAT_GOOGLE_API_KEY"

# ----------------------------------------------------------------------------
# 2) SUNUCU — Firebase Admin SDK (Render.com Environment Variables)
# ----------------------------------------------------------------------------
# İKİ biçimden BİRİ seçilir; bölünmüş değişkenler ÖNERİLİR (Render paneline
# tek satırlık dev JSON yapıştırmak hataya açıktır). Kod bölünmüş olanı
# bulursa JSON'a hiç bakmaz (server/adminApp.ts).
#
# Biçim A (önerilen) — service account JSON'ının üç alanı ayrı ayrı:
#   Firebase Console → Proje ayarları → Service accounts →
#   "Generate new private key" ile indirilen JSON'dan alın.
FIREBASE_PROJECT_ID="vanrehberim-f181b"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@vanrehberim-f181b.iam.gserviceaccount.com"
# DİKKAT: JSON'daki privateKey alanındaki \n kaçış dizileri OLDUĞU GİBİ
# bırakılır (tek satır); kod bunları gerçek satır sonuna çevirir
# (.replace(/\\n/g, '\n')). "Invalid private key" hatası alırsanız
# \n'lerin silinmiş olup olmadığını kontrol edin.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
#
# Biçim B (geriye uyumluluk) — tam service account JSON'ı tek satırlık
# string. Eksiksiz ve geçerli olmalıdır; FIREBASE_PROJECT_ID vb. tanımlıysa
# bu biçim yok sayılır.
# FIREBASE_SERVICE_ACCOUNT='{"project_id":"...","client_email":"...","private_key":"..."}'
#
# Her iki biçim de yoksa sunucu fail-closed davranır: /api/listings,
# /api/account ve /api/v1/* 503 döner.

# ----------------------------------------------------------------------------
# 3) SUNUCU — RevenueCat (sunucu tarafı ödeme doğrulaması, server/listings.ts)
# ----------------------------------------------------------------------------
# RevenueCat Dashboard → Settings → API keys → SECRET key (sk_ ile başlar).
# ASLA istemciye gömülmez, asla VITE_ ön eki almaz.
REVENUECAT_SECRET_API_KEY="sk_YOUR_REVENUECAT_SECRET_API_KEY"

# ----------------------------------------------------------------------------
# 4) SUNUCU — /api/v1 önbellek invalidasyonu (aşama 3)
# ----------------------------------------------------------------------------
# POST /api/v1/cache/clear endpoint'inin anahtarı. Bu secret TANIMLI
# DEĞİLSE endpoint kapalı kalır (fail-closed 503) — yani Render'da
# tanımlamazsanız manuel temizleme kapalıdır (otomatik invalidasyon
# listing yayınında her durumda çalışır, buna gerek duymaz).
# Tanımlarsanız isteğin `x-invalidation-secret` başlığı birebir aynı
# değeri göndermelidir. Uzun, rastgele bir string seçin (ör. 32+ karakter).
CACHE_INVALIDATION_SECRET="YOUR_LONG_RANDOM_SECRET"

# ----------------------------------------------------------------------------
# 5) SUNUCU — isteğe bağlı ayarlar
# ----------------------------------------------------------------------------
# /api/v1 IP rate limiti (dakikada istek; express-rate-limit). Varsayılan 60.
# API_V1_RATE_LIMIT_PER_MINUTE=60

# PORT: Render otomatik enjekte eder (Express dinler). Yerelde çalıştırırken
# gerekirse PORT=3000 şeklinde verilebilir. Render paneline girilmez.

# SCRAPERAPI_KEY: Render panelinde tanımlı eski bir değişkendir; kodda
# KULLANILMAZ. Silinmesi güvenlidir, ama zorunlu değildir.

# ----------------------------------------------------------------------------
# 6) KULLANILMAYAN ESKİ DEĞİŞKENLER (kodda referans yok — artık gerek yok)
# ----------------------------------------------------------------------------
# GEMINI_API_KEY, APP_URL : AI Studio şablonundan kalma; hiçbir yerde
# okunmazlar. Yerel .env'den silinebilirler.

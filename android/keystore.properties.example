# Örnek — release imzalama yapılandırması (kopyalayıp keystore.properties
# olarak kaydedin; gerçek dosya .gitignore'da olmalı ve ASLA commit edilmez!)
#
# 1) Play Console > Setup > App signing talimatlarıyla upload key oluşturun:
#      keytool -genkeypair -v -keystore upload.keystore -alias upload \
#        -keyalg RSA -keysize 2048 -validity 10000
# 2) upload.keystore dosyasını android/app/upload.keystore konumuna koyun
#    (build.gradle'daki storeFile bu yolu gösterir).
# 3) Bu dosyayı android/keystore.properties olarak kopyalayın ve şifreleri
#    gerçek değerlerle doldurun.
#
# Not: Dosya yoksa release imzalama yapılandırması atlanır (debug derlemesi
# etkilenmez); assembleRelease ancak bu dosya varsa çalışır.

storePassword=DEGISKEN_SIFRE
keyPassword=DEGISKEN_SIFRE
